{
  "kind": "redis",
  "defaultTab": "credentials",
  "tabs": [
    { "id": "credentials", "labelKey": "projects.config.tabs.credentials" },
    { "id": "source", "labelKey": "projects.config.tabs.source" },
    { "id": "network", "labelKey": "projects.config.tabs.network" },
    { "id": "settings", "labelKey": "projects.config.tabs.settings" }
  ],
  "sections": [
    {
      "id": "credentials",
      "labelKey": "projects.config.sections.credentials",
      "tab": "credentials",
      "fields": [
        {
          "id": "redis-host",
          "labelKey": "projects.config.fields.host",
          "type": "mono",
          "bind": "host",
          "editable": true,
          "placeholderText": "127.0.0.1"
        },
        {
          "id": "redis-port",
          "labelKey": "projects.config.fields.port",
          "type": "text",
          "optionKey": "port",
          "editable": true,
          "placeholderText": "6379"
        },
        {
          "id": "redis-db",
          "labelKey": "projects.config.fields.dbIndex",
          "type": "text",
          "optionKey": "dbIndex",
          "editable": true,
          "placeholderText": "0"
        },
        {
          "id": "redis-pass",
          "labelKey": "projects.config.fields.password",
          "type": "secret",
          "optionKey": "password",
          "editable": true,
          "hintKey": "projects.config.credentialHint"
        }
      ]
    },
    {
      "id": "source",
      "labelKey": "projects.config.sections.source",
      "tab": "source",
      "fields": [
        {
          "id": "img",
          "labelKey": "projects.config.sourceImage",
          "type": "image",
          "resolve": "image"
        },
        {
          "id": "vol",
          "labelKey": "projects.config.fields.volume",
          "type": "mono",
          "bind": "detail",
          "editable": true
        },
        {
          "id": "replicas",
          "labelKey": "projects.config.fields.replicas",
          "type": "text",
          "optionKey": "replicas",
          "editable": true,
          "placeholderKey": "projects.config.replicasPlaceholder"
        }
      ]
    },
    {
      "id": "networking",
      "labelKey": "projects.config.sections.networking",
      "tab": "network",
      "fields": [
        {
          "id": "url",
          "labelKey": "projects.config.publicNetworking",
          "type": "url",
          "bind": "host",
          "editable": true
        }
      ]
    },
    {
      "id": "danger",
      "labelKey": "projects.config.sections.danger",
      "tab": "settings",
      "fields": [
        {
          "id": "hint",
          "labelKey": "projects.config.dangerHint",
          "type": "hint",
          "resolve": "label"
        }
      ]
    }
