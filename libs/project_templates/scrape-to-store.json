      "from": "n-condition-1",
      "to": "n-postgres-1",
      "kind": "main"
    },
    {
      "id": "e-condition-fail",
      "from": "n-condition-1",
      "to": "n-notify-fail",
      "kind": "main"
    },
    {
      "id": "e-postgres-redis",
