# Panel UI login (auto-generated on first `scraper setup` or server start)
PANEL_AUTH_ENABLED=true
PANEL_USERNAME=
PANEL_PASSWORD=

# Browser
HEADLESS=true
BROWSER_TIMEOUT_MS=60000
REQUEST_DELAY_SECONDS=2

# Single proxy (or use config/proxies.txt for pool)
# PROXY_SERVER=http://user:pass@host:port
PROXY_LIST_PATH=config/proxies.txt
PROXY_ROTATION_STRATEGY=round_robin

# Scrape engine — concurrent workers (async parallel jobs)
MAX_CONCURRENT_JOBS=3

# Pricing
PRICE_MARKUP_PERCENT=35
DEFAULT_CURRENCY=USD

# AI extraction (OpenAI-compatible: OpenAI, Ollama, DeepSeek, etc.)
AI_ENABLED=false
AI_FALLBACK=true
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
# Ollama local: AI_BASE_URL=http://localhost:11434/v1  AI_MODEL=llama3.2
AI_MODEL=gpt-4o-mini
AI_MAX_HTML_CHARS=24000

# Shopee Open Platform — https://open.shopee.com/
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_ACCESS_TOKEN=

# Lazada Open Platform — https://open.lazada.com/
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_ACCESS_TOKEN=

# TikTok Shop — https://partner.tiktokshop.com/
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_SHOP_CIPHER=

# Shopify — https://admin.shopify.com/ → Apps → Develop apps
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01
