# Panel login + TCP bind — all other service config is in config/ui_config.json (web UI)

PANEL_AUTH_ENABLED=true
PANEL_USERNAME=
PANEL_PASSWORD=

# Server bind (TCP — listen on all interfaces)
PANEL_HOST=0.0.0.0
PANEL_PORT=8787

# Optional public IP/domain for login URLs (auto-set by deploy run / setup --external auto)
# PANEL_EXTERNAL_HOST=203.0.113.10

# Security entrance (auto on VPS install): secret path + access key; bare IP:port returns 404
# PANEL_ENTRY_PATH=a1b2c3d4
# PANEL_ACCESS_KEY=
# PANEL_SECURITY_ENTRANCE=true
# Disable: PANEL_ENTRY_PATH=off

# Optional: Telegram bot token (overrides config/ui_config.json → telegram.bot_token)
# TELEGRAM_BOT_TOKEN=
